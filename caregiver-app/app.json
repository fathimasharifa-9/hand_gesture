{
  "expo": {
    "name": "REACH Caregiver",
    "slug": "reach-caregiver",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8F7F4"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "REACH needs local network access to receive patient call requests from your laptop on Wi-Fi.",
        "NSBonjourServices": ["_http._tcp"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E9F9A"
      },
      "usesCleartextTraffic": true,
      "package": "com.reach.caregiver"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
